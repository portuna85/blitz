# 로컬 개발용 환경변수 템플릿입니다. 실제 값을 채운 뒤 .env 로 복사해서 사용하세요.
#   cp .env.example .env
# .env 파일은 .gitignore에 의해 커밋되지 않습니다.

# --- docker-compose로 띄우는 로컬 MariaDB ---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=blitz
MARIADB_USERNAME=blitz
MARIADB_PASSWORD=change-me

# --- 애플리케이션 데이터소스 (위 MariaDB 컨테이너를 가리킴) ---
MARIADB_URL=jdbc:mariadb://localhost:13306/blitz

# --- OAuth2 클라이언트 (Google/Naver 개발자 콘솔에서 발급) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
