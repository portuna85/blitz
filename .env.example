# Local development environment template.
# Copy this file to .env before running docker compose or the application.
# .env is ignored by Git and is imported by Spring through application.yml.

# MariaDB container settings used by docker-compose.yml.
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=blitz
MARIADB_USERNAME=blitz
MARIADB_PASSWORD=change-me
MARIADB_HOST_PORT=13306

# Application JDBC URL. The application-local.yml defaults match these values,
# so IntelliJ Run Application works as long as MariaDB is running.
MARIADB_URL=jdbc:mariadb://localhost:13306/blitz

# OAuth2 clients. Keep each ID and secret as a pair.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret
